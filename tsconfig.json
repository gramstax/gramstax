{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "gramstax": [
        "packages/gramstax/src/index.ts"
      ]
    },
    "composite": true, // Must be enable when use "references"
    // Environment setup & latest features
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": false,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "references": [
    {
      "path": "./packages/gramstax"
    },
    {
      "path": "./packages/create-gramstax"
    },
    {
      "path": "./example/1-complex"
    },
    {
      "path": "./example/2-helloworld"
    },
    {
      "path": "./example/4-echo"
    },
    {
      "path": "./example/5-interactive-menu"
    },
    {
      "path": "./example/6-bank-system"
    }
  ],
  "files": [],
  "include": [
    "*.ts"
  ]
}