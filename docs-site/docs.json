{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "gramstax",
  "description": "Page-based routing and a template system for Telegram bots.",
  "colors": {
    "primary": "#2563eb",
    "light": "#60a5fa",
    "dark": "#1d4ed8"
  },
  "logo": {
    "light": "/logo/gramstax.png",
    "dark": "/logo/gramstax.png",
    "href": "https://github.com/gramstax/gramstax"
  },
  "favicon": "/logo/gramstax.png",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/gramstax/gramstax"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/gramstax/gramstax"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gramstax/gramstax"
    }
  },
  "feedback": {
    "thumbsUp": true,
    "thumbsDown": true,
    "suggestEdit": {
      "url": "https://github.com/gramstax/gramstax",
      "base": "https://github.com/gramstax/gramstax/blob/main/docs-site/"
    }
  },
  "search": {
    "prompts": [
      {
        "prompt": "How do I add a page and turn it into a route?",
        "options": {
          "mode": "select"
        }
      },
      {
        "prompt": "Which deploy mode should I use?",
        "options": {
          "mode": "select"
        }
      },
      {
        "prompt": "How do I write a template and render it?",
        "options": {
          "mode": "select"
        }
      }
    ]
  },
  "thumbnails": {
    "background": "/logo/og-background.png"
  },
  "seo": {
    "indexing": "all",
    "organization": {
      "name": "Gramstax",
      "url": "https://github.com/gramstax/gramstax",
      "logo": "https://gramstax.mintlify.site/logo/gramstax.png",
      "sameAs": [
        "https://github.com/gramstax/gramstax"
      ]
    }
  },
  "navigation": {
    "$ref": "./config/navigation.json"
  }
}