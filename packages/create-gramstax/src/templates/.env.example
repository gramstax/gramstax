# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Bot Deployment Mode
# Options: 
#   - polling (default, recommended for development)
#   - webhook:https://yourdomain.com (for production)
BOT_DEPLOY=polling

# Environment
NODE_ENV=development

# Cache configuration for session
# Options: 
#   - memory
#   - redis://... (use redis)
CACHE_SESSION=memory
