# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Bot Deployment Mode
# Options: 
#   - polling
#   - webhook:https://yourdomain.com (dynamic value = url public)
#   - serverless:std/http (dynamic value = adapter)
BOT_DEPLOY=polling

# Environment
NODE_ENV=development

# Cache configuration for session
# Options: 
#   - memory
#   - redis://... (use redis)
CACHE_SESSION=memory
