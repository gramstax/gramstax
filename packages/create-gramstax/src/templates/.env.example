# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Bot Deployment Mode (bare mode; webhook/serverless details live in `optionsDeploy` in `gramstax.config.ts`)
# Options:
#   - polling
#   - webhook
#   - serverless
BOT_DEPLOY=polling

# Cache configuration for session
# Options: 
#   - memory
#   - redis:<url> | example: redis://127.0.0.1:6379
CACHE_SESSION_STORE=memory
CACHE_SESSION_TTL=14400000
CACHE_SESSION_NAMESPACE=s