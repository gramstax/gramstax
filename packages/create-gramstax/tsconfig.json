{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "bun"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "module": "Preserve",
    "target": "ESNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false
  },
  "include": [
    "*.ts",
    "src",
    "test"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/templates"
  ]
}