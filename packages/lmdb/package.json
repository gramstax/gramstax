{
  "name": "@gramstax/lmdb",
  "version": "6.1.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "description": "LMDB-backed key-value database with schema-declared repositories, embedded indexes, TTL, queues, and transactions. Multi-runtime (Bun, Node.js).",
  "keywords": [
    "lmdb",
    "key-value",
    "kv",
    "database",
    "repository",
    "sub-database",
    "transaction",
    "typescript",
    "bun",
    "nodejs",
    "gramstax"
  ],
  "scripts": {
    "build": "tsup",
    "build:docs": "bun run build --dts-only --no-minify --tsconfig tsconfig.build.docs.json && api-extractor run --local --verbose && api-documenter markdown -i ./docs/extractor/temp -o ./docs/markdown && api-documenter yaml -i ./docs/extractor/temp -o ./docs/yaml",
    "bench:crud": "bun run ./bench/crud.bench.ts",
    "bench:queue": "bun run ./bench/queue.bench.ts",
    "bench:range": "bun run ./bench/range.bench.ts",
    "bench:queries": "bun run ./bench/queries.bench.ts",
    "bench:transaction": "bun run ./bench/transaction.bench.ts",
    "bench:decode": "bun run ./bench/decode.bench.ts",
    "bench:concurrent": "bun run ./bench/concurrent.bench.ts",
    "bench:codec": "bun run ./bench/codec.bench.ts",
    "bench:index": "bun run ./bench/index.bench.ts",
    "bench:batch": "bun run ./bench/batch.bench.ts",
    "bench:ttl": "bun run ./bench/ttl.bench.ts",
    "bench:quick": "BENCH_N=1000 BENCH_CONC=10 bun run ./bench/crud.bench.ts && BENCH_N=1000 bun run ./bench/transaction.bench.ts && BENCH_N=1000 bun run ./bench/ttl.bench.ts",
    "bench:all": "bun run bench:crud && bun run bench:queue && bun run bench:range && bun run bench:queries && bun run bench:transaction && bun run bench:decode && bun run bench:concurrent && bun run bench:codec && bun run bench:index && bun run bench:batch && bun run bench:ttl",
    "nx-release-publish": "npm publish --provenance --access public"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramstax/gramstax.git",
    "directory": "packages/lmdb"
  },
  "bugs": {
    "url": "https://github.com/gramstax/gramstax/issues"
  },
  "homepage": "https://github.com/gramstax/gramstax",
  "author": "gramstax",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@types/bun": "latest",
    "cbor-x": "^1.6.5",
    "mitata": "^1.0.34",
    "tar": "^7.5.22",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "cbor-x": "^1.6.5",
    "@aws-sdk/client-s3": "^3.0.0",
    "tar": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "cbor-x": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "tar": {
      "optional": true
    }
  },
  "dependencies": {
    "croner": "^10.0.1",
    "lmdb": "^3.5.7"
  }
}
