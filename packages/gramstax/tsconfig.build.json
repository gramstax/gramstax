{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": false,
        "resolveJsonModule": true,
        "removeComments": true, // true will delete all comments in .js, .d.ts in folder ./dist
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*"
    ]
}