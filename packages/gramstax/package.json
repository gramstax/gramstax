{
  "name": "gramstax",
  "version": "6.1.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "description": "A modern Telegram bot framework built around page-based routing and a powerful template system.",
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-bot-api",
    "bot",
    "bot-framework",
    "framework",
    "telegram-framework",
    "typescript",
    "bun",
    "template-engine",
    "page-routing",
    "i18n",
    "gramstax"
  ],
  "scripts": {
    "build": "tsup",
    "build:docs": "bun run build --dts-only --no-minify --tsconfig tsconfig.build.docs.json && api-extractor run --local --verbose && api-documenter markdown -i ./docs/extractor/temp -o ./docs/markdown && api-documenter yaml -i ./docs/extractor/temp -o ./docs/yaml",
    "nx-release-publish": "npm publish --provenance --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramstax/gramstax.git",
    "directory": "packages/gramstax"
  },
  "bugs": {
    "url": "https://github.com/gramstax/gramstax/issues"
  },
  "homepage": "https://github.com/gramstax/gramstax",
  "author": "gramstax",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gramstax": "dist/src/cli/gramstax.js"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/chat-members": "^1.2.0",
    "@grammyjs/files": "^1.2.0",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/stream": "^1.1.0",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@keyv/redis": "^5.1.4",
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "dotenv": "^16.4.7",
    "grammy": "^1.46.0",
    "keyv": "^5.5.4",
    "logging-pretty": "^3.0.0"
  }
}
