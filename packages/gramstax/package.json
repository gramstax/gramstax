{
  "name": "gramstax",
  "version": "0.8.11",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "description": "",
  "keywords": [],
  "scripts": {
    "build": "tsup",
    "build:docs": "bun run build --dts-only --tsconfig tsconfig.build.docs.json && api-extractor run --local --verbose && api-documenter markdown -i ./docs/extractor/temp -o ./docs/markdown && api-documenter yaml -i ./docs/extractor/temp -o ./docs/yaml && rm -irf ./dist/gramstax.d.ts",
    "nx-release-publish": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramstax/gramstax.git"
  },
  "bugs": {
    "url": "https://github.com/gramstax/gramstax/issues"
  },
  "homepage": "https://github.com/gramstax/gramstax",
  "author": "gramstax",
  "license": "PROPRIETARY",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.4",
    "chokidar": "^4.0.3",
    "grammy": "^1.43.0",
    "keyv": "^5.5.4",
    "logging-pretty": "^3.0.0",
    "net-ipc": "^2.2.2"
  }
}
