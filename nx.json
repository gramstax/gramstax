{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/**/*.md"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore"
      ],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    }
  },
  "release": {
    "projects": ["packages/*"],
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "manifestRootsToUpdate": ["packages/{projectName}"],
      "currentVersionResolver": "git-tag",
      "specifierSource": "conventional-commits",
      "fallbackCurrentVersionResolver": "disk",
      "git": {
        "commit": true,
        "tag": true,
        "commitMessage": "chore: bump version to {version}",
        "stageChanges": true
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": {
        "createRelease": "github",
        "file": false,
        "renderOptions": {
          "authors": true,
          "versionTitleDate": true,
          "commitAuthors": {
            "enabled": true,
            "with": "name-and-username"
          }
        }
      },
      "projectChangelogs": {
        "createRelease": false,
        "file": false,
        "renderOptions": {
          "authors": false
        }
      }
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "🚀 Features"
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "🐛 Bug Fixes"
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": {
            "title": "🧹 Chores",
            "hidden": false
          }
        },
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "title": "🔨 Refactoring",
            "hidden": false
          }
        },
        "docs": {
          "semverBump": "none",
          "changelog": {
            "title": "📝 Documentation",
            "hidden": false
          }
        },
        "style": {
          "semverBump": "none",
          "changelog": {
            "title": "💄 Styles",
            "hidden": false
          }
        },
        "perf": {
          "semverBump": "none",
          "changelog": {
            "title": "⚡️ Performance Improvements",
            "hidden": false
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "title": "✅ Tests",
            "hidden": false
          }
        },
        "build": {
          "semverBump": "none",
          "changelog": {
            "title": "📦 Build System",
            "hidden": false
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": {
            "title": "⚙️ Continuous Integration",
            "hidden": false
          }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": {
            "title": "⏪ Reverts",
            "hidden": false
          }
        },
        "asset": {
          "semverBump": "none",
          "changelog": {
            "title": "🖼️ Assets",
            "hidden": false
          }
        }
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js",
      "options": {
        "buildTargetName": "build"
      }
    }
  ]
}
