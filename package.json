{
  "name": "gramstax-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint '**/*.ts'",
    "lint:fix": "eslint '**/*.ts' --fix",
    "build": "nx run-many --target=build --all",
    "build:gramstax": "nx build gramstax",
    "build:create-gramstax": "nx build create-gramstax",
    "publish:gramstax": "cd packages/gramstax && npm publish",
    "publish:create-gramstax": "cd packages/create-gramstax && npm publish",
    "publish:all": "bun run build && bun run publish:gramstax && bun run publish:create-gramstax",
    "version:patch": "npm version patch --workspaces",
    "version:minor": "npm version minor --workspaces",
    "version:major": "npm version major --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@eslint/json": "^0.13.2",
    "@nx/js": "^20.3.0",
    "@types/bun": "latest",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "nx": "^20.3.0",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
