{
  "name": "gramstax-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:all": "nx run-many -t build --parallel=1",
    "build:gramstax": "nx build gramstax",
    "build:create-gramstax": "nx build create-gramstax",
    "lint": "eslint .",
    "lint:fix": "eslint '**/*.ts' --fix",
    "version": "nx release version",
    "version:patch": "nx release version patch",
    "version:minor": "nx release version minor",
    "version:major": "nx release version major",
    "publish:all": "nx release publish",
    "publish:gramstax": "nx release publish gramstax",
    "publish:create-gramstax": "nx release publish create-gramstax",
    "release": "bun run version && bun run build:all && bun run publish:all",
    "release:patch": "bun run version:patch && bun run build:all && bun run publish:all",
    "release:minor": "bun run version:minor && bun run build:all && bun run publish:all",
    "release:major": "bun run version:major && bun run build:all && bun run publish:all",
    "dry-run": "nx release --dry-run",
    "dry-run:patch": "nx release --dry-run patch",
    "dry-run:minor": "nx release --dry-run minor",
    "dry-run:major": "nx release --dry-run major",
    "ci:test": "bun run lint && tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nx/js": "^22.1.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.3",
    "@types/bun": "latest",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "nx": "^22.1.3",
    "typescript-eslint": "^8.48.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
