{
  "name": "gramstax-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:all": "nx run-many -t build --parallel=1",
    "build:gramstax": "nx build gramstax",
    "build:create-gramstax": "nx build create-gramstax",
    "lint": "eslint '**/*.ts'",
    "lint:fix": "eslint '**/*.ts' --fix",
    "version": "nx release version",
    "version:patch": "nx release version --releaseAs patch",
    "version:minor": "nx release version --releaseAs minor",
    "version:major": "nx release version --releaseAs major",
    "publish:all": "nx release publish",
    "dry-run": "nx release --dry-run",
    "release": "bun run version && bun run build:all && bun run publish:all"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@eslint/json": "^0.13.2",
    "@nx/js": "^20.3.0",
    "@types/bun": "latest",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "nx": "^20.3.0",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
