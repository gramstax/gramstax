{
  "name": "gramstax-project",
  "version": "0.0.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@nx/js": "^22.1.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.3",
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "mitata": "^1.0.34",
    "nx": "^22.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "private": true,
  "scripts": {
    "test": "bun test ./example ./packages",
    "test:packages": "bun test ./packages",
    "test:example": "bun test ./example",
    "lint": "biome lint",
    "lint:fix": "biome lint --write --unsafe",
    "lint:packages": "biome lint ./packages",
    "lint:example": "biome lint ./example",
    "format": "biome format --write ./example ./packages",
    "format:example": "biome format --write ./example",
    "format:packages": "biome format --write ./packages",
    "build": "NX_DAEMON=false nx run-many -t build",
    "build:gramstax": "NX_DAEMON=false nx build gramstax",
    "build:create-gramstax": "NX_DAEMON=false nx build create-gramstax",
    "build:worker-thread": "NX_DAEMON=false nx build worker-thread",
    "version": "nx release version",
    "version:patch": "nx release version patch",
    "version:minor": "nx release version minor",
    "version:major": "nx release version major",
    "publish:all": "nx release publish",
    "publish:gramstax": "nx release publish gramstax",
    "publish:create-gramstax": "nx release publish create-gramstax",
    "publish:worker-thread": "nx release publish worker-thread",
    "release": "nx release --yes",
    "release:patch": "nx release patch --yes",
    "release:minor": "nx release minor --yes",
    "release:major": "nx release major --yes",
    "dry-run": "nx release --dry-run",
    "dry-run:patch": "nx release patch --dry-run",
    "dry-run:minor": "nx release minor --dry-run",
    "dry-run:major": "nx release major --dry-run",
    "ci:check": "tsc --noEmit && bun run lint",
    "ci:check:packages": "tsc --noEmit && bun run lint:packages",
    "ci:check:example": "bun run lint:example",
    "ci:test": "bun run ci:check && bun run test",
    "ci:test:packages": "bun run ci:check:packages && bun run test:packages",
    "ci:test:example": "bun run ci:check:example && bun test ./example",
    "prepush": "bun run ci:check && bun run test && bun run build && echo 'Its safe push to remote'"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "example/*"
  ]
}
